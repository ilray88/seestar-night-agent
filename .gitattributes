# 统一换行，避免 Windows/Linux 协作时整文件 diff
* text=auto

# Windows 脚本必须 CRLF；.ps1 还需保留 UTF-8 BOM（否则中文乱码）
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.py  text eol=lf
*.json text eol=lf
*.md  text eol=lf
*.toml text eol=lf
*.txt text eol=lf

# 二进制
*.jpg  binary
*.jpeg binary
*.png  binary
*.fit  binary
*.fits binary
*.pem  binary
*.xapk binary
